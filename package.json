{
	"name": "lintroll",
	"version": "0.0.0-semantic-release",
	"description": "privatenumber's linting CLI",
	"keywords": [
		"lint",
		"eslint",
		"typescript eslint",
		"eslint-config"
	],
	"license": "MIT",
	"repository": "privatenumber/lintroll",
	"funding": "https://github.com/privatenumber/lintroll?sponsor=1",
	"author": {
		"name": "Hiroki Osame",
		"email": "hiroki.osame@gmail.com"
	},
	"files": [
		"dist",
		"skills"
	],
	"type": "module",
	"bin": "./dist/cli/index.mjs",
	"main": "./dist/index.cjs",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.cts",
	"exports": {
		"require": {
			"types": "./dist/index.d.cts",
			"default": "./dist/index.cjs"
		},
		"import": {
			"types": "./dist/index.d.mts",
			"default": "./dist/index.mjs"
		}
	},
	"imports": {
		"#pvtnbr": {
			"types": "./src/index.ts",
			"development": "./src/index.ts",
			"default": "./dist/index.mjs"
		},
		"#pkg-maps-resolver": {
			"types": "./src/resolvers/pkg-maps-resolver.ts",
			"development": "./src/resolvers/pkg-maps-resolver.ts",
			"default": "./dist/resolvers/pkg-maps-resolver.cjs"
		},
		"#cli": {
			"development": "./src/cli/index.ts",
			"default": "./dist/cli/index.mjs"
		}
	},
	"packageManager": "pnpm@10.27.0",
	"scripts": {
		"bench": "node --expose-gc bench/lint.ts",
		"bench:rules": "node bench/rules.ts",
		"build": "pkgroll --export-condition=node --export-condition=development --minify --clean-dist",
		"type-check": "tsc",
		"lint": "node -C development ./src/cli/index.ts --git",
		"dev": "node --watch -C development tests/index.ts",
		"test": "node tests/index.ts",
		"prepack": "pnpm build && clean-pkg-json"
	},
	"engines": {
		"node": ">=20.20.0"
	},
	"dependencies": {
		"@eslint-community/eslint-plugin-eslint-comments": "^4.7.2",
		"@eslint/js": "^9.39.5",
		"@eslint/markdown": "^7.5.1",
		"@stylistic/eslint-plugin": "^5.10.0",
		"@typescript-eslint/eslint-plugin": "^8.63.0",
		"@typescript-eslint/parser": "^8.63.0",
		"cleye": "^2.6.0",
		"confusing-browser-globals": "^1.0.11",
		"eslint": "^9.39.5",
		"eslint-import-resolver-typescript": "^4.4.5",
		"eslint-plugin-import-x": "^4.17.1",
		"eslint-plugin-jsonc": "^3.3.0",
		"eslint-plugin-n": "^18.2.2",
		"eslint-plugin-no-use-extend-native": "0.7.3",
		"eslint-plugin-package-json": "^1.5.0",
		"eslint-plugin-promise": "^7.3.0",
		"eslint-plugin-react": "^7.37.5",
		"eslint-plugin-react-hooks": "^7.1.1",
		"eslint-plugin-regexp": "^3.1.1",
		"eslint-plugin-unicorn": "^63.0.0",
		"eslint-plugin-vue": "^10.9.2",
		"eslint-plugin-yml": "^3.6.1",
		"get-conditions": "^1.0.1",
		"get-tsconfig": "5.0.0-beta.6",
		"globals": "^17.7.0",
		"nano-spawn": "^2.1.0",
		"resolve-pkg-maps": "^1.0.0",
		"tsx": "^4.23.13",
		"vue-eslint-parser": "^10.4.1",
		"yaml-eslint-parser": "^2.1.0"
	},
	"devDependencies": {
		"@total-typescript/ts-reset": "^0.6.1",
		"@types/confusing-browser-globals": "^1.0.3",
		"@types/eslint": "^9.6.1",
		"@types/estree": "^1.0.9",
		"@types/node": "^26.1.2",
		"@types/react": "^19.2.18",
		"@typescript-eslint/rule-tester": "^8.63.0",
		"@typescript-eslint/utils": "^8.63.0",
		"clean-pkg-json": "^2.0.0",
		"find-up-simple": "^1.0.1",
		"fs-fixture": "^2.14.0",
		"manten": "2.0.2",
		"mitata": "^1.0.34",
		"pkgroll": "^2.27.1",
		"react": "^19.2.8",
		"read-package-up": "^12.0.0",
		"type-fest": "^5.8.0",
		"typescript": "^6.0.3"
	}
}
